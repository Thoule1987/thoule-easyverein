{
    "name": "thoule/easyverein",
    "description": "easyVerein-Anbindung fuer die Thoule-Laravel-Apps: API-Client mit Paginierung, automatische Key-Rotation, Mehr-Instanz-Faehigkeit",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.0",
        "laravel/socialite": "^5.28",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0"
    },
    "suggest": {
        "laravel/socialite": "Fuer den OIDC-Login ueber easyVerein (Treiber \"easyverein\")",
        "spatie/laravel-permission": "Fuer den mitgelieferten Gruppen-Rollen-Mapper"
    },
    "autoload": {
        "psr-4": {
            "Thoule\\EasyVerein\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Thoule\\EasyVerein\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Thoule\\EasyVerein\\EasyVereinServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "analyse": "phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
